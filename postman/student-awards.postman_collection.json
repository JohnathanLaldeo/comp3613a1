{
  "info": {
    "name": "Student Awards API",
    "description": "COMP 3613 Assignment 2 API tests.\n\nBefore each run: `python manage.py init` (resets the DB to seed data: bob/bobpass, admin/adminpass, 3 prizes), then `python manage.py run`.\nRun the whole collection in order with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth & authorization",
      "item": [
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Returns a bearer token for an admin\", function () {",
                  "    pm.expect(res.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(res.token_type).to.eql('bearer');",
                  "    pm.expect(res.role).to.eql('admin');",
                  "});",
                  "pm.collectionVariables.set(\"adminToken\", res.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Logs in the seeded admin and stores {{adminToken}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
