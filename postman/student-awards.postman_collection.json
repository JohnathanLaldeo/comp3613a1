      "name": "3. Admin - review hours",
      "item": [
        {
          "name": "Admin lists pending logs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const logs = pm.response.json();",
                  "pm.test(\"Only pending logs are returned\", function () {",
                  "    logs.forEach(l => pm.expect(l.status).to.eql('pending'));",
                  "});",
                  "pm.test(\"Includes the log submitted in this run\", function () {",
                  "    const id = Number(pm.collectionVariables.get(\"newLogId\"));",
                  "    pm.expect(logs.map(l => l.id)).to.include(id);",
                  "});"
